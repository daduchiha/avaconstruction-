<style>
  :root{
    --ink:#1B1D22;
    --paper:#F4F4F1;
    --grey:#8B9097;
    --red:#C8202E;
    --red-dark:#9B1822;
    --weld:#3F444A;
    --glare:#DDE4E5;
    --line:#D8D9D4;
    --maxw:1180px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{display:block;max-width:100%;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px;}
  h1,h2,h3{font-family:'Big Shoulders Display',sans-serif;font-weight:800;letter-spacing:0.01em;text-transform:uppercase;margin:0;line-height:0.95;}
  .mono{font-family:'IBM Plex Mono',monospace;letter-spacing:0.06em;text-transform:uppercase;}
  .skip-link{position:absolute;left:-999px;top:0;background:var(--red);color:#fff;padding:10px 16px;z-index:200;}
  .skip-link:focus{left:8px;top:8px;}
  :focus-visible{outline:3px solid var(--red);outline-offset:2px;}

  /* ---------- Logo ---------- */
  .logo{display:flex;align-items:center;gap:12px;}
  .logo-mark{
    width:38px;height:38px;flex:none;
    border:2.5px solid var(--red);
    transform:rotate(45deg);
    display:flex;align-items:center;justify-content:center;
    background:transparent;
  }
  .logo-mark span{
    transform:rotate(-45deg);
    font-family:'Yellowtail',cursive;
    font-size:21px;color:var(--ink);
    margin-top:2px;
  }
  footer .logo-mark{background:#fff;}
  footer .logo-mark span{color:var(--ink);}
  .logo-word{font-family:'Yellowtail',cursive;font-size:26px;color:var(--ink);white-space:nowrap;}
  .logo-sub{font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.18em;text-transform:uppercase;color:var(--grey);display:block;margin-top:-2px;}

  /* ---------- Nav ---------- */
  header.site{
    position:sticky;top:0;z-index:100;
    background:rgba(244,244,241,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  nav.bar{display:flex;align-items:center;justify-content:space-between;padding:14px 0;}
  nav.bar .links{display:flex;gap:28px;align-items:center;}
  nav.bar .links a{font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.08em;text-transform:uppercase;color:var(--weld);padding:4px 0;border-bottom:2px solid transparent;}
  nav.bar .links a:hover{border-bottom:2px solid var(--red);color:var(--ink);}
  .call-pill{
    background:var(--red);color:#fff;font-family:'IBM Plex Mono',monospace;
    font-size:13px;letter-spacing:0.04em;padding:10px 18px;border-radius:2px;font-weight:600;
    white-space:nowrap;
  }
  .call-pill:hover{background:var(--red-dark);}
  .burger{display:none;background:none;border:2px solid var(--ink);width:42px;height:38px;flex-direction:column;justify-content:center;gap:5px;align-items:center;cursor:pointer;}
  .burger span{display:block;width:20px;height:2px;background:var(--ink);}
  @media (max-width:880px){
    nav.bar{flex-wrap:wrap;}
    nav.bar .links{
      order:3;flex-basis:100%;width:100%;
      flex-direction:column;align-items:flex-start;gap:0;
      max-height:0;overflow:hidden;
      transition:max-height 0.3s ease;
      background:var(--paper);
    }
    nav.bar .links.open{max-height:420px;border-top:1px solid var(--line);}
    nav.bar .links a{width:100%;padding:14px 28px;border-bottom:1px solid var(--line);}
    .burger{display:flex;}
    .nav-call{display:none;}
  }

  /* ---------- Hero ---------- */
  .hero{
    position:relative;overflow:hidden;
    background:var(--ink);color:var(--paper);
    padding:90px 0 70px;
  }
  .hero .diamond-bg{
    position:absolute;top:-160px;right:-160px;width:440px;height:440px;
    border:3px solid var(--red);opacity:0.35;transform:rotate(45deg);
  }
  .hero .diamond-bg.two{top:auto;bottom:-220px;right:auto;left:-200px;width:340px;height:340px;opacity:0.18;}
  .hero-inner{position:relative;z-index:2;max-width:760px;}
  .eyebrow{font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.22em;color:var(--red);text-transform:uppercase;display:block;margin-bottom:18px;}
  .hero h1{font-size:clamp(2.6rem,6vw,4.6rem);color:#fff;}
  .hero h1 em{font-style:normal;color:var(--red);}
  .hero p.lede{font-size:1.15rem;color:var(--glare);max-width:560px;margin:24px 0 34px;line-height:1.55;font-weight:400;}
  .cta-row{display:flex;gap:14px;flex-wrap:wrap;}
  .btn{display:inline-flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:13.5px;letter-spacing:0.05em;text-transform:uppercase;padding:15px 24px;border-radius:2px;font-weight:600;transition:transform 0.15s ease, background 0.15s ease;}
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{background:var(--red);color:#fff;}
  .btn-primary:hover{background:var(--red-dark);}
  .btn-ghost{border:1.5px solid var(--glare);color:#fff;}
  .btn-ghost:hover{background:rgba(255,255,255,0.08);}

  /* ---------- Hazard divider ---------- */
  .hazard{
    height:10px;width:100%;
    background:repeating-linear-gradient(135deg,var(--ink) 0 14px, var(--red) 14px 28px);
  }

  /* ---------- Marquee ---------- */
  .marquee-wrap{background:var(--weld);color:var(--paper);overflow:hidden;padding:16px 0;}
  .marquee{display:flex;width:max-content;gap:48px;animation:scroll 28s linear infinite;}
  .marquee span{font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;white-space:nowrap;color:var(--glare);}
  .marquee span b{color:#fff;}
  @keyframes scroll{from{transform:translateX(0);}to{transform:translateX(-50%);}}
  @media (prefers-reduced-motion: reduce){.marquee{animation:none;}}

  /* ---------- Section generic ---------- */
  section{padding:90px 0;}
  .section-head{max-width:640px;margin-bottom:54px;}
  .section-head .eyebrow{color:var(--red);}
  .section-head h2{font-size:clamp(1.9rem,4vw,2.8rem);}
  .section-head p{color:var(--weld);font-size:1.02rem;line-height:1.6;margin-top:16px;}
  .on-dark .section-head h2{color:#fff;}
  .on-dark .section-head p{color:var(--glare);}

  /* ---------- Services grid ---------- */
  .grid-services{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  .svc-card{background:var(--paper);padding:30px 26px;min-height:200px;display:flex;flex-direction:column;justify-content:space-between;transition:background 0.2s;}
  .svc-card:hover{background:#fff;}
  .svc-num{font-family:'IBM Plex Mono',monospace;color:var(--grey);font-size:12px;}
  .svc-card h3{font-size:1.15rem;text-transform:none;font-weight:700;margin-top:14px;letter-spacing:0;}
  .svc-card p{color:var(--weld);font-size:0.92rem;line-height:1.5;margin-top:8px;}
  @media (max-width:980px){.grid-services{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:600px){.grid-services{grid-template-columns:1fr;}}

  /* ---------- Why TPO / cross-section ---------- */
  .tpo-section{background:var(--ink);color:var(--paper);}
  .tpo-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;}
  @media (max-width:900px){.tpo-grid{grid-template-columns:1fr;}}
  .tpo-copy p{color:var(--glare);line-height:1.7;font-size:1rem;margin-bottom:18px;}
  .spec-row{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:32px;}
  .spec{border-top:2px solid var(--red);padding-top:10px;}
  .spec b{display:block;font-family:'Big Shoulders Display';font-size:1.9rem;color:#fff;}
  .spec span{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:0.1em;color:var(--grey);text-transform:uppercase;}

  .cross-section{font-family:'IBM Plex Mono',monospace;}
  .torn-off{
    border:1.5px dashed #7a5658;background:rgba(200,32,46,0.08);
    padding:14px 16px;margin-bottom:8px;opacity:0.7;
    display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;
  }
  .torn-off .t-name{text-decoration:line-through;color:#d6a3a8;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;}
  .torn-off .t-spec{font-size:10px;color:var(--grey);letter-spacing:0.06em;text-transform:uppercase;}
  .haul-arrow{text-align:right;font-size:10.5px;color:var(--red);letter-spacing:0.12em;margin-bottom:18px;}
  .stack .layer{
    padding:16px 18px;margin-bottom:6px;border-left:5px solid var(--red);
    display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;
    opacity:0;transform:translateY(18px);transition:opacity 0.55s ease, transform 0.55s ease;
  }
  .stack .layer.is-visible{opacity:1;transform:translateY(0);}
  .layer-name{font-size:13px;letter-spacing:0.08em;color:#fff;text-transform:uppercase;font-weight:600;}
  .layer-spec{font-size:10.5px;color:var(--grey);letter-spacing:0.06em;text-transform:uppercase;text-align:right;}
  .layer.membrane{background:#ECEDEB;border-left-color:var(--red);}
  .layer.membrane .layer-name{color:var(--ink);}
  .layer.coverboard{background:#3a3f45;}
  .layer.insulation{background:#33373c;}
  .layer.deck{background:#2a2e32;}
  .weld-note{font-size:9.5px;color:var(--red);letter-spacing:0.1em;margin:-2px 0 14px;text-align:right;}
  @media (prefers-reduced-motion: reduce){
    .stack .layer{opacity:1;transform:none;transition:none;}
  }

  /* ---------- Process ---------- */
  .process-list{counter-reset:step;}
  .pstep{
    display:grid;grid-template-columns:90px 1fr;gap:24px;padding:28px 0;border-top:1px solid var(--line);
    opacity:0;transform:translateY(16px);transition:opacity 0.5s ease,transform 0.5s ease;
  }
  .pstep.is-visible{opacity:1;transform:translateY(0);}
  .pstep:last-child{border-bottom:1px solid var(--line);}
  .pstep .pnum{font-family:'Big Shoulders Display';font-size:2.6rem;color:var(--red);line-height:1;}
  .pstep h3{font-size:1.2rem;text-transform:none;letter-spacing:0;margin-bottom:6px;}
  .pstep p{color:var(--weld);font-size:0.95rem;line-height:1.55;margin:0;max-width:620px;}
  @media (prefers-reduced-motion: reduce){.pstep{opacity:1;transform:none;}}
  @media (max-width:560px){.pstep{grid-template-columns:50px 1fr;}.pstep .pnum{font-size:1.8rem;}}

  /* ---------- Building types ---------- */
  .grid-buildings{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  @media (max-width:980px){.grid-buildings{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:560px){.grid-buildings{grid-template-columns:1fr;}}
  .bldg-card{border:1px solid var(--line);background:#fff;padding:26px 22px;}
  .bldg-card svg{width:34px;height:34px;stroke:var(--red);margin-bottom:16px;}
  .bldg-card h3{font-size:1.02rem;text-transform:none;letter-spacing:0;font-weight:700;}
  .bldg-card p{color:var(--weld);font-size:0.88rem;line-height:1.5;margin-top:8px;}

  /* ---------- Our Work gallery ---------- */
  .work-section{background:var(--ink);}
  .gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;grid-auto-flow:dense;}
  .g-item{position:relative;overflow:hidden;margin:0;aspect-ratio:4/3;background:#101215;border:1px solid #2c3036;cursor:pointer;}
  .g-item img,.g-item video{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease;}
  .g-item:hover img{transform:scale(1.05);}
  .g-item.wide{grid-column:span 2;}
  .g-item.video{cursor:default;}
  .g-cap{position:absolute;left:0;right:0;bottom:0;padding:28px 12px 10px;background:linear-gradient(transparent,rgba(16,18,21,.88));color:#fff;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;pointer-events:none;}
  .g-item.video .g-cap{bottom:auto;top:0;padding:8px 12px 26px;background:linear-gradient(rgba(16,18,21,.85),transparent);}
  @media (max-width:900px){.gallery-grid{grid-template-columns:repeat(2,1fr);}}

  /* ---------- Lightbox ---------- */
  .lightbox{position:fixed;inset:0;z-index:400;background:rgba(14,15,18,.96);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:18px;}
  .lightbox[hidden]{display:none;}
  .lightbox img{max-width:96vw;max-height:76vh;object-fit:contain;}
  .lb-cap{margin-top:14px;color:#cfd3d8;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;text-align:center;max-width:90vw;}
  .lb-btn{position:fixed;background:rgba(255,255,255,.08);border:1px solid #3a3f45;color:#fff;width:46px;height:46px;display:flex;align-items:center;justify-content:center;font-size:24px;cursor:pointer;border-radius:2px;}
  .lb-btn:hover{background:var(--red);border-color:var(--red);}
  #lbClose{top:16px;right:16px;}
  #lbPrev{left:10px;top:50%;transform:translateY(-50%);}
  #lbNext{right:10px;top:50%;transform:translateY(-50%);}

  /* ---------- Why us ---------- */
  .why-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;}
  @media (max-width:880px){.why-grid{grid-template-columns:1fr;}}
  .why-list{list-style:none;margin:0;padding:0;}
  .why-list li{display:flex;gap:16px;padding:18px 0;border-top:1px solid var(--line);}
  .why-list li:last-child{border-bottom:1px solid var(--line);}
  .why-diamond{width:11px;height:11px;border:2px solid var(--red);transform:rotate(45deg);flex:none;margin-top:6px;}
  .why-list strong{display:block;font-size:1rem;margin-bottom:3px;}
  .why-list span{color:var(--weld);font-size:0.92rem;line-height:1.5;}
  .quote-card{background:var(--ink);color:#fff;padding:40px 32px;position:relative;}
  .quote-card .qmark{position:absolute;top:18px;left:24px;font-family:'Big Shoulders Display';font-size:4rem;color:var(--red);opacity:0.5;line-height:1;}
  .quote-card p{font-size:1.1rem;line-height:1.6;position:relative;z-index:2;margin:30px 0 22px;}
  .quote-card .who{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;color:var(--grey);text-transform:uppercase;}

  /* ---------- Service area ---------- */
  .area-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;}
  @media (max-width:880px){.area-grid{grid-template-columns:1fr;}}
  .area-list{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px;}
  .area-list span{border:1px solid var(--line);padding:7px 13px;font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:0.05em;text-transform:uppercase;color:var(--weld);}
  .map-frame{border:1px solid var(--line);height:340px;width:100%;filter:grayscale(15%);}

  /* ---------- Final CTA ---------- */
  .final-cta{background:var(--red);color:#fff;text-align:left;}
  .final-cta .wrap{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:30px;}
  .final-cta h2{color:#fff;font-size:clamp(1.8rem,4vw,2.6rem);max-width:560px;}
  .final-cta .btn-ghost{border-color:#fff;}
  .final-cta .btn-primary{background:var(--ink);}
  .final-cta .btn-primary:hover{background:#000;}

  /* ---------- Footer ---------- */
  footer{background:var(--ink);color:var(--glare);padding:64px 0 28px;}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:48px;border-bottom:1px solid #34383d;padding-bottom:40px;}
  @media (max-width:880px){.foot-grid{grid-template-columns:1fr;gap:34px;}}
  .foot-grid h4{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:var(--red);margin:0 0 16px;}
  .foot-grid p,.foot-grid a{display:block;font-size:0.92rem;line-height:1.7;color:var(--glare);margin-bottom:6px;}
  .foot-grid a:hover{color:#fff;text-decoration:underline;}
  .foot-bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;padding-top:24px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:0.05em;color:var(--grey);text-transform:uppercase;}

  /* ---------- Mobile call bar ---------- */
  .mobile-call{
    display:none;position:fixed;bottom:0;left:0;right:0;z-index:150;
    background:var(--red);color:#fff;text-align:center;padding:14px;
    font-family:'IBM Plex Mono',monospace;letter-spacing:0.06em;text-transform:uppercase;font-size:13px;font-weight:600;
  }
  @media (max-width:700px){
    .mobile-call.show{display:block;}
    section{padding:64px 0;}
    .hero{padding:70px 0 50px;}
  }
</style>
</head>
