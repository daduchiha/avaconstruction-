<script>
  // mobile nav
  const burger = document.getElementById('burger');
  const navLinks = document.getElementById('navLinks');
  burger.addEventListener('click', () => {
    const open = navLinks.classList.toggle('open');
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    navLinks.classList.remove('open');
    burger.setAttribute('aria-expanded', 'false');
  }));
  // close the mobile menu as soon as the page is scrolled, so it can't get stuck open over the content
  window.addEventListener('scroll', () => {
    if (navLinks.classList.contains('open')) {
      navLinks.classList.remove('open');
      burger.setAttribute('aria-expanded', 'false');
    }
  }, { passive: true });

  // footer year
  document.getElementById('year').textContent = new Date().getFullYear();

  // mobile sticky call bar after hero
  const mobileCall = document.getElementById('mobileCall');
  const heroEl = document.querySelector('.hero');
  const callObserver = new IntersectionObserver(entries => {
    entries.forEach(e => mobileCall.classList.toggle('show', !e.isIntersecting));
  }, { threshold: 0 });
  callObserver.observe(heroEl);

  // scroll reveal for cross-section layers and process steps
  const reveal = (selector, staggerMs) => {
    const items = document.querySelectorAll(selector);
    const obs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const idx = [...items].indexOf(entry.target);
          setTimeout(() => entry.target.classList.add('is-visible'), idx * staggerMs);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.25 });
    items.forEach(i => obs.observe(i));
  };
  reveal('.stack .layer', 140);
  reveal('.pstep', 90);

  // gallery lightbox
  const gallery = [...document.querySelectorAll('.g-item:not(.video)')];
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lbImg');
  const lbCap = document.getElementById('lbCap');
  let gIdx = 0;
  function openLb(i){
    gIdx = i;
    const im = gallery[i].querySelector('img');
    lbImg.src = im.src;
    lbCap.textContent = im.alt;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeLb(){ lb.hidden = true; document.body.style.overflow = ''; }
  function stepLb(d){ openLb((gIdx + d + gallery.length) % gallery.length); }
  gallery.forEach((g, i) => g.addEventListener('click', () => openLb(i)));
  document.getElementById('lbClose').addEventListener('click', closeLb);
  document.getElementById('lbPrev').addEventListener('click', e => { e.stopPropagation(); stepLb(-1); });
  document.getElementById('lbNext').addEventListener('click', e => { e.stopPropagation(); stepLb(1); });
  lb.addEventListener('click', e => { if (e.target === lb) closeLb(); });
  document.addEventListener('keydown', e => {
    if (lb.hidden) return;
    if (e.key === 'Escape') closeLb();
    if (e.key === 'ArrowLeft') stepLb(-1);
    if (e.key === 'ArrowRight') stepLb(1);
  });
</script>

